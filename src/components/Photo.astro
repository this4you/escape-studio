---
import { Image, getImage } from 'astro:assets';
import { findPhoto, themes } from '../data/photos';

// Photo slot that shows the current theme's image (CSS picks it, see .photo__img in global.css)
// and falls back to the gradient placeholder when a theme has no file for `name`.
interface Props {
  name: string;
  alt: string;
  class?: string;
  // Above-the-fold image (hero): load eagerly with high priority.
  priority?: boolean;
  // Optional phone variant: slot name of a separate image used up to `mobileBreakpoint` px (art direction via <picture>).
  mobile?: string;
}

const { name, alt, class: className, priority = false, mobile } = Astro.props;
const mobileBreakpoint = 800;

const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
// Client photos arrive already compressed; Astro's default (~80) re-encode visibly softens them.
const quality = 90;

const variants = await Promise.all(
  themes.map(async (theme) => {
    const src = findPhoto(theme, name);
    const mobileSrc = mobile ? findPhoto(theme, mobile) : undefined;
    return {
      theme,
      src,
      mobileImg: mobileSrc ? await getImage({ src: mobileSrc, format: 'webp', quality }) : undefined,
    };
  })
);
---

<div class:list={['photo', className]}>
  {
    variants.map(({ theme, src, mobileImg }) =>
      src && mobileImg ? (
        <picture>
          <source media={`(max-width: ${mobileBreakpoint}px)`} srcset={mobileImg.src} type="image/webp" />
          <Image src={src} alt={alt} class={`photo__img photo__img--${theme}`} {loading} {fetchpriority} {quality} />
        </picture>
      ) : (
        src && <Image src={src} alt={alt} class={`photo__img photo__img--${theme}`} {loading} {fetchpriority} {quality} />
      )
    )
  }
  <slot />
</div>
