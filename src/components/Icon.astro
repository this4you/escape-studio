---
// Line icons drawn on a 24×24 grid, stroked with currentColor.
const paths = {
  lotus:
    'M12 20c-4 0-8-2-9-6 3 0 5 1 6 2M12 20c4 0 8-2 9-6-3 0-5 1-6 2M12 20c-2-2-3-4-3-7 0-2 1-4 3-6 2 2 3 4 3 6 0 3-1 5-3 7ZM9 13c-2-1-4-1-5 0M15 13c2-1 4-1 5 0',
  mat: 'M4 8a4 4 0 0 1 8 0v8a4 4 0 0 1-8 0V8ZM8 8a1 1 0 1 0 0 .01M12 6h6a2 2 0 0 1 2 2v8a4 4 0 0 1-4 4H8',
  heart: 'M12 20s-7-4.4-9-9a5 5 0 0 1 9-4 5 5 0 0 1 9 4c-2 4.6-9 9-9 9Z',
  heel: 'M3 17c3 0 5-2 7-6l2-4c1-2 3-3 5-3l1 3c-2 0-3 2-3 4v9M15 13l3 1c2 .7 3 2 3 3H3',
  dumbbell: 'M3 10v4M6 7v10M6 12h12M18 7v10M21 10v4',
  bolt: 'M13 3 5 14h6l-1 7 8-11h-6l1-7Z',
  sparkle: 'M12 3c.5 4.5 2 6 6.5 6.5-4.5.5-6 2-6.5 6.5-.5-4.5-2-6-6.5-6.5C10 9 11.5 7.5 12 3ZM18.5 15c.2 1.8.8 2.4 2.5 2.5-1.7.2-2.3.8-2.5 2.5-.2-1.7-.8-2.3-2.5-2.5 1.7-.1 2.3-.7 2.5-2.5Z',
  people:
    'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 11a2.5 2.5 0 1 0 0-5M21 20c0-2.8-1.6-5-4-5.7',
  arrow: 'M4 12h15M14 6l6 6-6 6',
  plus: 'M12 5v14M5 12h14',
  pin: 'M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  phone:
    'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z',
  instagram:
    'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm5.5-9.5h.01',
  telegram: 'M21 4 3 11l6 2 2 6 3-4 5 4 2-15ZM9 13l9-7-6 8',
} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
