---
import Icon from './Icon.astro';
import { studio } from '../data/studio';
---

<section class="section" id="location" aria-labelledby="location-title">
  <div class="container">
    <h2 class="section-title" id="location-title">Як нас знайти</h2>
    <div class="location">
      <div>
        <p class="address">
          {studio.address.street}, {studio.address.locality}, {studio.address.city}
          <small>{studio.address.note}</small>
        </p>
        <a class="btn btn--ghost" href={studio.mapUrl} target="_blank" rel="noopener">
          <Icon name="pin" size={18} /> Дивитись на карті
        </a>
      </div>
      <iframe
        class="map"
        src={studio.mapEmbedUrl}
        title={`Студія ${studio.name} на карті Google Maps`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<style>
  .location {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  .address {
    margin: 0 0 24px;
    font-size: 1.1rem;
  }

  small {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .map {
    width: 100%;
    height: 360px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    /* Dark look for the default (light) Google map to match the page. */
    filter: invert(0.92) hue-rotate(180deg) saturate(0.7);
  }

  @media (max-width: 860px) {
    .location {
      grid-template-columns: 1fr;
    }

    .map {
      height: 280px;
    }
  }
</style>
