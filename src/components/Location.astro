---
import Icon from './Icon.astro';
import { studio } from '../data/studio';
---

<section class="section" id="location" aria-labelledby="location-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Локація</p>
      <h2 class="section-title" id="location-title">Як нас знайти</h2>
    </div>
    <div class="location">
      <div>
        <p class="address">
          {studio.address.street}, {studio.address.locality}, {studio.address.city}
          <small>{studio.address.note}</small>
        </p>
        <a class="btn btn--ghost" href={studio.mapUrl} target="_blank" rel="noopener">
          <Icon name="pin" size={18} /> Дивитись на карті
        </a>
      </div>
      <div class="map-wrap">
      <iframe
        class="map"
        src={studio.mapEmbedUrl}
        title={`Студія ${studio.name} на карті Google Maps`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
        <!-- The embed is centred on the studio, so a ring at the centre marks it. -->
        <span class="map-pulse pulse" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
  }

  .address {
    margin: 0 0 28px;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .address small {
    margin-top: 8px;
    font-family: var(--font-body);
    letter-spacing: 0;
  }

  small {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .map-wrap {
    position: relative;
  }

  .map-pulse {
    --pulse-color: var(--pink-strong);
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border: 2px solid var(--pink-strong);
    border-radius: 50%;
    pointer-events: none;
  }

  .map {
    display: block;
    width: 100%;
    height: 400px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    /* Dark look for the default (light) Google map to match the page. */
    filter: invert(0.92) hue-rotate(180deg) saturate(0.7);
  }

  @media (max-width: 860px) {
    .location {
      grid-template-columns: 1fr;
    }

    .map {
      height: 280px;
    }
  }
</style>
