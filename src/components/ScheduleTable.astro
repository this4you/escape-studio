---
import type { ScheduleGroup } from '../data/content';

interface Props {
  title: string;
  id: string;
  groups: ScheduleGroup[];
}

const { title, id, groups } = Astro.props;
---

<div class="schedule">
  <h3 class="schedule__title" id={id}>
    {title}
  </h3>
  <div class="tabs">
    {
      groups.length > 1 && (
        <div class="tablist" role="radiogroup" aria-label={`${title}: дні тижня`}>
          {groups.map((g, i) => (
            <>
              <input class="visually-hidden" type="radio" name={id} id={`${id}-${i}`} checked={i === 0} />
              <label for={`${id}-${i}`}>{g.days}</label>
            </>
          ))}
        </div>
      )
    }
    <div class="tabpanels">
      {
        groups.map((g) => (
          <div>
            <table class="table" aria-labelledby={id}>
              <caption class={`days days--${g.tone} ${groups.length > 1 ? 'tabpanel__label' : ''}`}>{g.days}</caption>
              <thead class="visually-hidden">
                <tr>
                  <th scope="col">Час</th>
                  <th scope="col">Заняття</th>
                  <th scope="col">Тренерка</th>
                </tr>
              </thead>
              <tbody>
                {g.rows.map((r) => (
                  <tr>
                    <td class="time">{r.time}</td>
                    <td class="title">
                      {r.title}
                      {r.note && <small>({r.note})</small>}
                    </td>
                    <td class="trainer">{r.trainer}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .schedule {
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .schedule__title {
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    font-weight: 500;
    margin-bottom: 20px;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .table + .table,
  .tabpanels > * + * {
    margin-top: 20px;
  }

  .days {
    caption-side: top;
    text-align: left;
    padding: 5px 14px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-accent);
    width: fit-content;
    margin-bottom: 8px;
  }

  .days--pink {
    background: var(--pink);
  }

  .days--gold {
    background: var(--gold);
  }

  td {
    padding: 14px 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    transition: background-color 0.2s;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  tr:hover td {
    background: var(--surface);
  }

  .time {
    width: 72px;
    font-family: var(--font-display);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--pink);
    white-space: nowrap;
  }

  .title {
    font-weight: 600;
  }

  .title small {
    display: block;
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .trainer {
    width: 110px;
    text-align: right;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 480px) {
    .time {
      width: 60px;
    }

    .trainer {
      width: auto;
    }
  }
</style>
