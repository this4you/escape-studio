---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { directions } from '../data/content';

// Drawn icons: src/assets/icons/<photo>.png; directions without one fall back to the SVG `icon`.
const iconImages = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.png', { eager: true });
const iconImage = (name: string) => iconImages[`../assets/icons/${name}.png`]?.default;
---

<section class="section" id="directions" aria-labelledby="directions-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Що ми пропонуємо</p>
      <h2 class="section-title" id="directions-title">Напрямки</h2>
    </div>
    <ul class="grid">
      {
        directions.map((d, i) => (
          <li class:list={['card', 'reveal-item', { 'card--wide': i === 0 }]}>
            <Photo name={d.photo} alt={`${d.name} у студії руху ESCAPE`} class="card__photo" />
            <span class="card__icon">
              {(() => {
                const img = iconImage(d.photo);
                return img ? (
                  <Image src={img} alt="" width={56} height={56} class="card__icon-img" />
                ) : (
                  <Icon name={d.icon} size={22} />
                );
              })()}
            </span>
            <div class="card__body">
              <h3>{d.name}</h3>
              <p>{d.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(280px, 28vw, 360px);
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    isolation: isolate;
  }

  .card--wide {
    grid-column: span 2;
    grid-row: span 2;
  }

  .card :global(.card__photo) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .card :global(.photo__img) {
    transition: transform 0.8s var(--ease);
  }

  .card:hover :global(.photo__img) {
    transform: scale(1.06);
  }

  .card :global(.card__photo)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 35%, rgb(12 10 12 / 0.92) 100%);
  }

  .card__icon {
    position: absolute;
    top: 14px;
    left: 14px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(12 10 12 / 0.45);
    border: 1px solid rgb(255 255 255 / 0.18);
    backdrop-filter: blur(12px);
    color: var(--gold);
  }

  .card__icon :global(.card__icon-img) {
    width: 24px;
    height: 24px;
  }

  .card__body {
    padding: 20px;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .card--wide h3 {
    font-size: clamp(1.4rem, 2.6vw, 2rem);
  }

  p {
    margin: 8px 0 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: rgb(246 240 243 / 0.75);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 320px;
    }

    .card--wide {
      grid-row: span 1;
    }
  }

  /* Phones: horizontal swipe carousel instead of nine stacked tiles. */
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      grid-auto-rows: 400px;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .grid::-webkit-scrollbar {
      display: none;
    }

    .card {
      scroll-snap-align: start;
    }

    .card--wide {
      grid-column: auto;
    }

    .card--wide h3 {
      font-size: 1.15rem;
    }
  }
</style>
