---
import Icon from './Icon.astro';
import { directions } from '../data/content';
---

<section class="section" id="directions" aria-labelledby="directions-title">
  <div class="container">
    <h2 class="section-title" id="directions-title">Напрямки</h2>
    <ul class="grid">
      {
        directions.map((d) => (
          <li class="card">
            <div class="card__photo photo" aria-hidden="true" />
            <h3>{d.name}</h3>
            <p>{d.description}</p>
            <Icon name={d.icon} size={28} class="card__icon" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6px 6px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .card:hover {
    border-color: var(--pink);
    box-shadow: var(--glow);
  }

  .card__photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: calc(var(--radius) - 4px);
  }

  h3 {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    margin-top: 14px;
    min-height: 2.4em;
    display: grid;
    place-items: center;
  }

  /* Description is for search engines & screen readers; visible only on wider cards. */
  p {
    display: none;
    margin: 6px 0 0;
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .card :global(.card__icon) {
    margin-top: auto;
    padding-top: 12px;
    color: var(--gold);
    box-sizing: content-box;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }

    p {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .card__photo {
      aspect-ratio: 4 / 3;
    }
  }
</style>
