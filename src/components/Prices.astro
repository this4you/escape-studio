---
import Icon from './Icon.astro';
import { prices, type PriceOption } from '../data/content';
import { studio } from '../data/studio';

const fmt = (o: PriceOption) => `${o.amount} ${o.unit}`;
---

<section class="section" id="prices" aria-labelledby="prices-title">
  <div class="container">
    <div class="head section-head">
      <div>
        <p class="eyebrow">Вартість</p>
        <h2 class="section-title" id="prices-title">Прайс</h2>
      </div>
      <p class="promo"><span class="pulse-dot" aria-hidden="true"></span> Перше заняття — безкоштовно</p>
    </div>
    <ul class="grid">
      {
        prices.map((card) =>
          card.options.length === 1 ? (
            <li class="reveal-item">
              <a
                class:list={['tile', { 'tile--featured': card.featured }]}
                href={studio.bookingUrl}
                target="_blank"
                rel="noopener"
                aria-label={`${card.title}: ${fmt(card.options[0])}, онлайн запис`}
              >
                <span class="tag">{card.options[0].tag}</span>
                <h3 class="title">{card.title}</h3>
                {card.subtitle && <span class="subtitle">{card.subtitle}</span>}
                <span class="price">
                  <span class="amount"><strong>{card.options[0].amount}</strong> {card.options[0].unit}</span>
                  {card.options[0].note && <small>{card.options[0].note}</small>}
                </span>
                <span class:list={['arrow', { pulse: card.featured }]} aria-hidden="true">
                  <Icon name="arrow" size={18} />
                </span>
              </a>
            </li>
          ) : (
            <li class="reveal-item wide">
              <div class="bundle">
                <div class="bundle__options">
                  {card.options.map((o) => (
                    <a
                      class="tile tile--option"
                      href={studio.bookingUrl}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${o.tag}, ${card.title}: ${fmt(o)}, онлайн запис`}
                    >
                      <span class="tag">{o.tag}</span>
                      <span class="price">
                        <span class="amount"><strong>{o.amount}</strong> {o.unit}</span>
                        {o.note && <small>{o.note}</small>}
                      </span>
                      <span class="arrow" aria-hidden="true">
                        <Icon name="arrow" size={18} />
                      </span>
                    </a>
                  ))}
                </div>
                <div class="bundle__plate">
                  <h3 class="title">{card.title}</h3>
                  {card.subtitle && <span class="subtitle">{card.subtitle}</span>}
                </div>
              </div>
            </li>
          )
        )
      }
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .head .section-title {
    margin-bottom: 0;
  }

  .promo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 8px 18px 8px 14px;
    border-radius: 999px;
    border: 1px solid rgb(234 219 138 / 0.35);
    background: rgb(234 219 138 / 0.08);
    color: var(--gold);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-flow: row dense;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wide {
    grid-column: span 2;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 280px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.3s,
      background-color 0.3s,
      transform 0.3s var(--ease);
  }

  .tile:hover {
    border-color: rgb(246 161 200 / 0.6);
    background: var(--surface-hover);
    transform: translateY(-3px);
  }

  .tile--featured {
    border-color: rgb(246 161 200 / 0.5);
    background:
      radial-gradient(120% 120% at 0% 0%, rgb(255 126 182 / 0.2), transparent 60%),
      var(--surface);
  }

  .tag {
    align-self: flex-start;
    margin-bottom: 20px;
    padding: 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tile--featured .tag {
    border-color: rgb(246 161 200 / 0.5);
    color: var(--pink);
  }

  .title {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .subtitle {
    margin-top: 6px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Big number, small unit, thin «2 рази на тиждень» caption under it. */
  .price {
    margin-top: auto;
    padding-top: 28px;
    padding-right: 52px;
    font-size: 0.9rem;
    color: var(--pink);
  }

  .amount {
    white-space: nowrap;
  }

  strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 2.6vw, 2.3rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  small {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--text-muted);
  }

  .arrow {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--text-muted);
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s,
      transform 0.3s var(--ease);
  }

  .tile--featured .arrow {
    --pulse-color: var(--pink-strong);
  }

  .tile:hover .arrow,
  .tile--featured .arrow {
    background: var(--accent-grad);
    border-color: transparent;
    color: var(--on-accent);
  }

  .tile:hover .arrow {
    transform: rotate(-45deg);
  }

  /* Two subscriptions of the same directions: options side by side, shared plate underneath. */
  .bundle {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .bundle__options {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .tile--option {
    min-height: 200px;
    border: 0;
    border-radius: 0;
    background: none;
  }

  .tile--option + .tile--option {
    border-left: 1px solid var(--line);
  }

  .tile--option:hover {
    transform: none;
  }

  .bundle__plate {
    padding: 18px 24px;
    border-top: 1px solid rgb(246 161 200 / 0.25);
    background: linear-gradient(90deg, rgb(255 126 182 / 0.14), rgb(242 160 255 / 0.08));
  }

  .bundle__plate .subtitle {
    display: block;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .wide {
      grid-column: auto;
    }

    .tile {
      min-height: 0;
      padding: 20px;
    }

    .tile--option {
      min-height: 170px;
      padding: 18px 16px;
    }

    .tile--option .price {
      padding-right: 0;
      padding-bottom: 52px;
      font-size: 0.8rem;
    }

    .tile--option strong {
      font-size: 1.5rem;
    }

    .tile--option .arrow {
      right: auto;
      left: 16px;
      bottom: 16px;
    }

    .bundle__plate {
      padding: 16px 20px;
    }
  }
</style>
