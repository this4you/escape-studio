---
import Icon from './Icon.astro';
import { prices } from '../data/content';
import { studio } from '../data/studio';
---

<section class="section" id="prices" aria-labelledby="prices-title">
  <div class="container">
    <h2 class="section-title" id="prices-title">Прайс</h2>
    <p class="promo">Перше заняття — безкоштовно</p>
    <div class="tabs">
      <div class="tablist" role="radiogroup" aria-label="Категорія прайсу">
        {
          prices.map((g, i) => (
            <>
              <input class="visually-hidden" type="radio" name="prices" id={`prices-${i}`} checked={i === 0} />
              <label for={`prices-${i}`}>{g.label}</label>
            </>
          ))
        }
      </div>
      <div class="tabpanels">
        {
          prices.map((g) => (
            <div class="group">
              <h3 class="tabpanel__label">{g.label}</h3>
              <div class="columns">
                {g.columns.map((column) => (
                  <ul class="list">
                    {column.map((item) => (
                      <li>
                        <a class="item" href={studio.bookingUrl} target="_blank" rel="noopener">
                          <span class="item__title">
                            {item.title}
                            {item.note && <small>{item.note}</small>}
                          </span>
                          <span class="item__prices">
                            {item.prices.map((p) => (
                              <span class="price">
                                {p.label && <small>{p.label}</small>}
                                <strong>{p.value}</strong>
                              </span>
                            ))}
                          </span>
                          <Icon name="arrow" size={20} class="item__arrow" />
                        </a>
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .promo {
    display: inline-block;
    margin: -16px 0 24px;
    padding: 6px 16px;
    border-radius: 999px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .group + .group {
    margin-top: 32px;
  }

  h3 {
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .item:hover {
    border-color: var(--pink);
    box-shadow: var(--glow);
  }

  .item__title {
    flex: 1;
    font-size: 0.9rem;
  }

  small {
    display: block;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .item__prices {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: right;
  }

  strong {
    color: var(--pink);
    white-space: nowrap;
  }

  .item :global(.item__arrow) {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
