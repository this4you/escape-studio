---
import Icon from './Icon.astro';
import { studio } from '../data/studio';
---

<section class="section" id="instagram" aria-labelledby="instagram-title">
  <div class="container">
    <div class="insta">
      <Icon name="instagram" size={32} class="insta__icon" />
      <div class="insta__text">
        <h2 id="instagram-title">Хочеш дізнатись більше?</h2>
        <p>Переходь на наш Instagram — там основний контент: відео з тренувань, новини та анонси студії.</p>
      </div>
      <a class="btn" href={studio.social.instagram} target="_blank" rel="noopener">
        Наш Instagram <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .insta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 28px;
    padding: clamp(28px, 5vw, 56px);
    border: 1px solid rgb(246 161 200 / 0.3);
    border-radius: calc(var(--radius) + 6px);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(242 160 255 / 0.22), transparent 60%),
      radial-gradient(70% 120% at 0% 100%, rgb(255 126 182 / 0.22), transparent 60%),
      var(--bg-raised);
    overflow: hidden;
  }

  .insta :global(.insta__icon) {
    flex-shrink: 0;
    box-sizing: content-box;
    padding: 14px;
    border-radius: 20px;
    background: var(--accent-grad);
    color: var(--on-accent);
  }

  .insta__text {
    flex: 1 1 280px;
  }

  h2 {
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 500;
  }

  p {
    margin: 8px 0 0;
    color: var(--text-muted);
  }
</style>
