---
// Client's current logo: ESCAPE wordmark + «студія руху для дітей та дорослих», white on transparent (src/assets/logo.png).
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- 480px = 2× the largest display width (header), WebP keeps the transparency. -->
<Image src={logo} alt="" width={480} class={className} loading="eager" />
