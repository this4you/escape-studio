---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { studio } from '../data/studio';
import { directions } from '../data/content';

const facts = [
  { value: String(directions.length), label: 'напрямків' },
  { value: '6–8', label: 'людей у групі' },
  { value: '3+', label: 'років — для дітей' },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Photo name="hero" alt="Тренування з йоги у студії ESCAPE" class="hero__visual" priority />
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="badge"><span class="badge__dot" aria-hidden="true"></span> Перше заняття — безкоштовно</p>
      <h1 id="hero-title">
        Твій простір <br />для <em>руху</em>
        <span class="visually-hidden">— студія руху {studio.name} у {studio.address.localityIn}, {studio.address.city}</span>
      </h1>
      <p class="hero__quote">
        Ти не можеш керувати всім, що відбувається навколо. Але можеш обрати, як почуватися всередині.
      </p>
      <div class="hero__actions">
        <a class="btn" href={studio.bookingUrl} target="_blank" rel="noopener">
          Онлайн запис <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn--ghost" href="#schedule">Розклад занять</a>
      </div>
      <ul class="facts">
        {
          facts.map((f) => (
            <li>
              <strong>{f.value}</strong>
              <span>{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section class="intro" aria-label="Про ESCAPE коротко">
  <div class="container">
    <p class="intro__text">
      Тому ми створили {studio.name} — сучасну студію руху для дітей та дорослих у {studio.address.localityIn}, де можна
      переключити увагу з усього зовнішнього на <em>себе</em>: на своє тіло, дихання, рух і власний стан. Тренування,
      що надихають, відновлюють і дають енергію.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(860px, calc(100svh - 76px));
    padding-block: clamp(48px, 8vw, 96px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero :global(.hero__visual) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero :global(.photo__img) {
    object-position: 100% 20%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.photo__img) {
      animation: zoom-out 1.8s var(--ease) both;
    }
  }

  @keyframes zoom-out {
    from {
      transform: scale(1.08);
    }
  }

  .hero :global(.hero__visual)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(12 10 12 / 0.92) 10%, rgb(12 10 12 / 0.35) 55%, transparent 80%),
      linear-gradient(0deg, var(--bg) 0%, transparent 35%);
  }

  .hero__content {
    max-width: 780px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 8px 16px 8px 12px;
    border: 1px solid rgb(234 219 138 / 0.35);
    border-radius: 999px;
    background: rgb(234 219 138 / 0.08);
    backdrop-filter: blur(10px);
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 0 rgb(234 219 138 / 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .badge__dot {
      animation: pulse 2.2s infinite;
    }
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 10px rgb(234 219 138 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(234 219 138 / 0);
    }
  }

  h1 {
    font-size: clamp(2.6rem, 7.5vw, 5.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  h1 :global(em),
  h1 em {
    background: var(--text-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.08em;
  }

  .hero__quote {
    max-width: 44ch;
    margin: 28px 0 36px;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: rgb(246 240 243 / 0.78);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 48px 0 0;
    padding: 24px 0 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .facts li {
    display: flex;
    flex-direction: column;
  }

  .facts strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .facts span {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .intro {
    padding-block: clamp(56px, 9vw, 112px) 0;
  }

  .intro__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 2.4rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 38ch;
  }

  .intro__text em {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 500;
    font-size: 1.15em;
    color: var(--pink);
  }

  /* Phones: the banner's four faces sit at 60–95% of its width, so instead of a full-height background
     the photo becomes a 5:4 block on top showing the right ~60% of the 2:1 banner (faces end at ~50% of its height).
     Its lower part fades out (mask, so no seam against the page glow) and the badge + heading sit over that fade. */
  @media (max-width: 800px) {
    .hero {
      display: block;
      min-height: 0;
      padding-top: 52vw;
      padding-bottom: 48px;
    }

    .hero :global(.hero__visual) {
      inset: 0 0 auto;
      aspect-ratio: 5 / 4;
      mask-image: linear-gradient(180deg, #000 62%, transparent 100%);
    }

    .hero :global(.photo__img) {
      object-position: 100% 50%;
    }

    .hero :global(.hero__visual)::before {
      background: linear-gradient(0deg, rgb(12 10 12 / 0.75) 0%, transparent 50%);
    }

    .facts {
      gap: 12px 28px;
    }
  }
</style>
