---
import Icon from './Icon.astro';
import { studio } from '../data/studio';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title">
        Твій простір <br />для себе
        <span class="visually-hidden">— студія руху {studio.name} у {studio.address.localityIn}, {studio.address.city}</span>
      </h1>
      <ul class="hero__words" aria-label="Наші цінності">
        <li>Рух</li>
        <li>Баланс</li>
        <li>Сила</li>
        <li>Енергія</li>
        <li>Ти</li>
      </ul>
      <p class="hero__lead">
        Сучасна студія руху для дорослих та дітей у {studio.address.localityIn}: йога, пілатес, стретчинг, танці та
        фітнес. Тренування, що надихають, відновлюють і дають енергію. <strong>Перше заняття — безкоштовно.</strong>
      </p>
      <a class="btn" href={studio.bookingUrl} target="_blank" rel="noopener">
        Онлайн запис <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="hero__visual photo" aria-hidden="true">
      <p class="hero__motto">Small<br />people<br />big<br />moves</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--hero-glow);
    padding-block: clamp(40px, 7vw, 88px);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    color: var(--pink);
    text-shadow: var(--glow);
  }

  .hero__words {
    list-style: none;
    padding: 0;
    margin: 28px 0;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .hero__words::after {
    content: '';
    display: block;
    width: 32px;
    height: 2px;
    margin-top: 12px;
    background: var(--gold);
  }

  .hero__lead {
    max-width: 44ch;
    margin: 0 0 32px;
    color: var(--text-muted);
  }

  .hero__lead strong {
    color: var(--text);
  }

  .hero__visual {
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px var(--radius) var(--radius);
  }

  .hero__motto {
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-height: 360px;
      aspect-ratio: auto;
      height: 70vw;
    }
  }
</style>
