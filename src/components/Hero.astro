---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { studio } from '../data/studio';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <h1 id="hero-title">
        Твій простір <br />для себе
        <span class="visually-hidden">— студія руху {studio.name} у {studio.address.localityIn}, {studio.address.city}</span>
      </h1>
      <ul class="hero__words" aria-label="Наші цінності">
        <li>Рух</li>
        <li>Баланс</li>
        <li>Сила</li>
        <li>Енергія</li>
        <li>Ти</li>
      </ul>
      <p class="hero__lead">
        Сучасна студія руху для дорослих та дітей у {studio.address.localityIn}: йога, пілатес, стретчинг, танці та
        фітнес. Тренування, що надихають, відновлюють і дають енергію. <strong>Перше заняття — безкоштовно.</strong>
      </p>
      <a class="btn" href={studio.bookingUrl} target="_blank" rel="noopener">
        Онлайн запис <Icon name="arrow" size={18} />
      </a>
    </div>
    <Photo name="hero" alt="Тренування з йоги у студії ESCAPE" class="hero__visual" priority>
      <p class="hero__motto" aria-hidden="true">Small<br />people<br />big<br />moves</p>
    </Photo>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--hero-glow);
    padding-block: clamp(40px, 7vw, 88px);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 4rem);
    color: var(--pink);
    text-shadow: var(--glow);
  }

  .hero__words {
    list-style: none;
    padding: 0;
    margin: 28px 0;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .hero__words::after {
    content: '';
    display: block;
    width: 32px;
    height: 2px;
    margin-top: 12px;
    background: var(--gold);
  }

  .hero__lead {
    max-width: 44ch;
    margin: 0 0 32px;
    color: var(--text-muted);
  }

  .hero__lead strong {
    color: var(--text);
  }

  .hero__inner > * {
    position: relative;
    z-index: 1;
  }

  /* Both designs: the wide photo fills the hero behind the text. */
  .hero {
    min-height: min(640px, 80vh);
    display: flex;
    align-items: center;
  }

  .hero :global(.hero__visual) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero :global(.photo__img) {
    object-position: 70% 30%;
  }

  .hero :global(.hero__visual)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, var(--bg) 15%, transparent 60%), linear-gradient(0deg, var(--bg), transparent 25%);
  }

  .hero__motto {
    position: absolute;
    right: var(--gutter);
    top: 40px;
    z-index: 1;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-align: right;
    color: var(--text-muted);
  }

  @media (max-width: 800px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero :global(.hero__visual)::before {
      background: linear-gradient(0deg, var(--bg) 10%, color-mix(in srgb, var(--bg) 55%, transparent));
    }

    .hero__motto {
      display: none;
    }
  }
</style>
