---
import Photo from './Photo.astro';
import { trainers } from '../data/content';
---

<section class="section" id="trainers" aria-labelledby="trainers-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Команда</p>
      <h2 class="section-title" id="trainers-title">Наші тренери</h2>
    </div>
    <ul class="grid">
      {
        trainers.map((t) => (
          <li class="card reveal-item">
            <Photo name={t.photo} alt={`${t.name} — тренерка студії ESCAPE`} class="card__photo" />
            <div class="card__info">
              <h3>{t.name}</h3>
              <ul class="tags">
                {t.specialties.map((s) => <li>{s}</li>)}
              </ul>
              {t.bio && (
                <details>
                  <summary>Про тренерку</summary>
                  <p class="bio">{t.bio}</p>
                </details>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    display: flex;
    isolation: isolate;
    align-items: flex-end;
  }

  .card :global(.card__photo) {
    position: absolute;
    inset: 0;
  }

  .card :global(.card__photo)::after {
    inset: 14% 24% 30%;
  }

  .card :global(.photo__img) {
    object-position: 50% 20%;
    transition: transform 0.8s var(--ease);
  }

  .card:hover :global(.photo__img) {
    transform: scale(1.05);
  }

  .card__info {
    position: relative;
    z-index: 1;
    width: 100%;
    max-height: 100%;
    overflow-y: auto;
    padding: 20px;
    padding-top: 48px;
    background: linear-gradient(transparent, rgb(12 10 12 / 0.9) 60%);
  }

  .card__info:has(details[open]) {
    background: rgb(12 10 12 / 0.9);
    backdrop-filter: blur(8px);
  }

  summary {
    width: fit-content;
    margin-top: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pink);
    cursor: pointer;
  }

  .bio {
    font-size: 0.8rem;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.5;
    color: var(--text);
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 3px 10px;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
  }

  .bio {
    margin: 8px 0 0;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .grid {
      gap: 10px;
    }

    .card__info {
      padding: 32px 12px 12px;
    }

    h3 {
      font-size: 0.95rem;
    }

    .tags li {
      font-size: 0.7rem;
    }
  }
</style>
