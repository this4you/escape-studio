---
import Photo from './Photo.astro';
import ScheduleTable from './ScheduleTable.astro';
import { adultSchedule, kidsSchedule } from '../data/content';
---

<section class="section" id="schedule" aria-labelledby="schedule-title">
  <div class="container">
    <h2 class="visually-hidden" id="schedule-title">Розклад занять</h2>
    <div class="columns">
      <ScheduleTable title="Розклад" subtitle="для дорослих" id="schedule-adults" groups={adultSchedule} />
      <div>
        <ScheduleTable title="Розклад" subtitle="для дітей" id="schedule-kids" groups={kidsSchedule} />
        <Photo name="schedule" alt="Зал студії ESCAPE з неоновою вивіскою" class="hall"><span aria-hidden="true">Escape</span></Photo>
      </div>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
  }

  .columns :global(.hall) {
    margin-top: 12px;
    aspect-ratio: 16 / 8;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    display: grid;
    place-items: center;
  }

  .columns :global(.hall)::after {
    display: none;
  }

  .columns :global(.hall .photo__img) {
    object-position: 85% 50%;
  }

  /* The photo already shows the sign. */
  :global(:root[data-theme='neon'] .hall:has(> .photo__img--neon) > span),
  :global(:root:not([data-theme='neon']) .hall:has(> .photo__img--graphite) > span) {
    display: none;
  }

  .columns :global(.hall) span {
    position: relative;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--pink);
    text-shadow: var(--glow);
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
