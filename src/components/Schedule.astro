---
import Photo from './Photo.astro';
import ScheduleTable from './ScheduleTable.astro';
import { adultSchedule, kidsSchedule } from '../data/content';
---

<section class="section" id="schedule" aria-labelledby="schedule-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Обирай свій час</p>
      <h2 class="section-title" id="schedule-title">Розклад занять</h2>
    </div>
    <div class="columns">
      <ScheduleTable title="Для дорослих" id="schedule-adults" groups={adultSchedule} />
      <div class="side">
        <ScheduleTable title="Для дітей" id="schedule-kids" groups={kidsSchedule} />
        <Photo name="schedule" alt="Учасниці студії ESCAPE у брендованій формі" class="hall"><span aria-hidden="true">Escape</span></Photo>
      </div>
    </div>
  </div>
</section>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 48px);
  }

  /* Photo under the kids table stretches to the bottom of the (taller) adults table. */
  .side {
    display: flex;
    flex-direction: column;
  }

  .columns :global(.hall) {
    flex: 1;
    margin-top: 16px;
    min-height: 260px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
  }

  .columns :global(.hall)::after {
    display: none;
  }

  /* Portrait shot: on the wide desktop frame keep the band with heads and the ESCAPE prints on the tops. */
  .columns :global(.hall .photo__img) {
    object-position: 50% 40%;
  }

  @media (max-width: 860px) {
    .columns :global(.hall) {
      flex: none;
      aspect-ratio: 4 / 5;
      min-height: 0;
    }
  }

  /* The photo already shows the sign. */
  :global(:root[data-theme='neon'] .hall:has(.photo__img--neon) > span),
  :global(:root:not([data-theme='neon']) .hall:has(.photo__img--graphite) > span) {
    display: none;
  }

  .columns :global(.hall) span {
    position: relative;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--pink);
    text-shadow: var(--glow);
  }

  @media (max-width: 860px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
