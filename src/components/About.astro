---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { aboutFeatures } from '../data/content';
import { studio } from '../data/studio';
---

<section class="about" id="about" aria-labelledby="about-title">
  <Photo name="about" alt="Зал студії ESCAPE: дзеркала, неонове світло, килимки" class="about__visual" />
  <div class="about__content">
    <h2 class="section-title" id="about-title">Про студію</h2>
    <p>
      {studio.name} — це більше, ніж тренування. Це простір, де ти можеш побути собою, відновити енергію, відчути
      своє тіло та знайти баланс. Ми поєднуємо сучасні методики, комфортну атмосферу та професійну команду, щоб рух
      став частиною твого життя.
    </p>
    <p class="muted">
      Ми у {studio.address.localityIn}: {studio.address.street}, {studio.address.note}.
      {`Раніше студія працювала як ${studio.formerName}.`}
    </p>
    <ul class="features">
      {
        aboutFeatures.map((f) => (
          <li>
            <Icon name={f.icon} size={32} />
            <span>{f.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-block: 1px solid var(--line);
  }

  .about :global(.about__visual) {
    min-height: 360px;
  }

  .about :global(.about__visual)::after {
    inset: 20% 30% -10%;
  }

  .about__content {
    padding: clamp(40px, 6vw, 72px) var(--gutter);
    max-width: 620px;
  }

  p {
    margin: 0 0 16px;
  }

  .muted {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .features li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .features span {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about :global(.about__visual) {
      min-height: 240px;
    }
  }

  @media (max-width: 480px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
