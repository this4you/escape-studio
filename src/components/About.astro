---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { aboutFeatures } from '../data/content';
import { studio } from '../data/studio';
---

<section class="about" id="about" aria-labelledby="about-title">
  <Photo name="about" alt="Зал студії ESCAPE: дзеркала, неонове світло, килимки" class="about__visual" />
  <div class="about__content">
    <p class="eyebrow">Про студію</p>
    <h2 class="section-title" id="about-title">Більше, ніж <em>тренування</em></h2>
    <p>
      {studio.name} — це більше, ніж тренування. Це простір, де ти можеш побути собою, відновити енергію, відчути
      своє тіло та знайти баланс. Ми поєднуємо сучасні методики, комфортну атмосферу та професійну команду, щоб рух
      став частиною твого життя. А невеликі групи по 6–8 людей дозволяють тренеру приділити увагу кожному, допомогти
      з технікою та врахувати індивідуальні особливості.
    </p>
    <p class="muted">
      {
        `Ми у ${studio.address.localityIn}: ${studio.address.street}, ${studio.address.note}. Раніше студія працювала як ${studio.formerName}.`
      }
    </p>
    <ul class="features">
      {
        aboutFeatures.map((f) => (
          <li>
            <Icon name={f.icon} size={26} />
            <span>{f.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    max-width: var(--container);
    margin-inline: auto;
    padding: clamp(64px, 10vw, 128px) var(--gutter);
  }

  .about :global(.about__visual) {
    min-height: 520px;
    height: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  .about :global(.about__visual)::after {
    inset: 20% 30% -10%;
  }

  .about__content {
    max-width: 600px;
  }

  .about__content p {
    font-size: 1.05rem;
  }

  p {
    margin: 0 0 16px;
  }

  .muted {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--gold);
  }

  .features :global(svg) {
    flex-shrink: 0;
  }

  .features span {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about :global(.about__visual) {
      min-height: 300px;
    }
  }

  @media (max-width: 420px) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
